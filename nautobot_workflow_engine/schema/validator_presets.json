{
  "description": "Ready-made validation rules for the builder's Insert preset menu. Each pattern uses syntax that Python re and JavaScript RegExp read the same way. Tests check every example in both.",
  "presets": [
    {
      "id": "hostname",
      "label": "Hostname",
      "regex": "^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "message": "Enter a hostname: letters, numbers, and hyphens, with dots between parts (for example core-sw01.lab.example.com).",
      "flags": [],
      "valid": ["core-sw01", "rtr1.dc1.example.com", "LEAF-101", "a", "edge-01.site-b.example.net"],
      "invalid": ["-leaf1", "leaf1-", "sw 01", "sw_01", "core..sw01", "rtr1.example.com.", ""]
    },
    {
      "id": "ipv4_address",
      "label": "IPv4 address",
      "regex": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
      "message": "Enter an IPv4 address, like 10.0.0.1.",
      "flags": [],
      "valid": ["10.0.0.1", "192.168.1.254", "0.0.0.0", "255.255.255.255", "172.16.10.5"],
      "invalid": ["256.1.1.1", "10.0.0", "10.0.0.1/24", "10.0.0.01", "a.b.c.d", "10.0.0.1.5"]
    },
    {
      "id": "ipv4_network",
      "label": "IPv4 network (CIDR)",
      "regex": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:3[0-2]|[12]?[0-9])$",
      "message": "Enter an IPv4 network with its prefix length, like 10.20.0.0/24.",
      "flags": [],
      "valid": ["10.20.0.0/24", "192.168.0.0/16", "0.0.0.0/0", "172.16.5.4/32", "10.0.0.0/8"],
      "invalid": ["10.20.0.0", "10.20.0.0/33", "10.20.0.0/", "300.1.1.0/24", "10.20.0.0/24/1", "10.20.0.0 /24"]
    },
    {
      "id": "mac_address",
      "label": "MAC address",
      "regex": "^(?:[0-9A-Fa-f]{2}([:-])(?:[0-9A-Fa-f]{2}\\1){4}[0-9A-Fa-f]{2}|[0-9A-Fa-f]{4}\\.[0-9A-Fa-f]{4}\\.[0-9A-Fa-f]{4})$",
      "message": "Enter a MAC address, like 00:1A:2B:3C:4D:5E, 00-1a-2b-3c-4d-5e, or 001a.2b3c.4d5e.",
      "flags": [],
      "valid": ["00:1A:2B:3C:4D:5E", "00-1a-2b-3c-4d-5e", "001a.2b3c.4d5e", "ff:ff:ff:ff:ff:ff"],
      "invalid": ["00:1A:2B:3C:4D", "00:1A-2B:3C:4D:5E", "001A2B3C4D5E", "00:1A:2B:3C:4D:5G", "001a.2b3c.4d5"]
    },
    {
      "id": "interface_name",
      "label": "Interface name",
      "regex": "^[A-Za-z][A-Za-z-]*[0-9]+(?:[/:][0-9]+)*(?:\\.[0-9]+)?$",
      "message": "Enter an interface name, like GigabitEthernet1/0/1, Ethernet1/1.100, xe-0/0/0, or Port-channel10.",
      "flags": [],
      "valid": ["GigabitEthernet1/0/1", "Gi1/0/24", "Ethernet1/1.100", "xe-0/0/0", "et-0/0/1:2", "Port-channel10", "Vlan100", "Loopback0", "mgmt0", "eth0"],
      "invalid": ["1/0/1", "Gi 1/0/1", "Gi1//1", "eth", "Gi1/0/1.", "Ethernet1/1-2"]
    },
    {
      "id": "vlan_name",
      "label": "VLAN name",
      "regex": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$",
      "message": "Use 1 to 32 letters, numbers, hyphens, underscores, or dots, starting with a letter or number.",
      "flags": [],
      "valid": ["USERS", "voice_vlan", "mgmt-10", "DMZ.web", "V100"],
      "invalid": ["users vlan", "-users", "_users", "this-vlan-name-is-much-too-long-for-it", "guest!"]
    },
    {
      "id": "servicenow_change",
      "label": "ServiceNow change number",
      "regex": "^CHG[0-9]{7}$",
      "message": "Enter a ServiceNow change number, like CHG0012345.",
      "flags": [],
      "valid": ["CHG0012345", "CHG9999999"],
      "invalid": ["CHG12345", "chg0012345", "INC0012345", "CHG00123456", "CHG 0012345"]
    }
  ]
}
